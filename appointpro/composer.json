{
    "name": "appointpro/appointpro",
    "description": "AppointPro – Ultimate WordPress Appointment Booking & Scheduling System",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "AppointPro Engineering Team",
            "email": "support@appointpro.io"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "AppointPro\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AppointPro\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
